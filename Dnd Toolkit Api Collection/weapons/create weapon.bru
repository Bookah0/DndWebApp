meta {
  name: create weapon
  type: http
  seq: 3
}

post {
  url: {{ENV}}/api/weapons
  body: json
  auth: inherit
}

body:json {
  {
    "Name": "Iron Longsword",
    "Description": "A standard-issue steel longsword used by trained fighters.",
    "Value": 150,
    "Rarity": "Common",
    "RequiresAttunement": false,
    "Weight": 3,
