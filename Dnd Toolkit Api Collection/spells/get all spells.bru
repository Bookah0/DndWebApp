meta {
  name: get all spells
  type: http
  seq: 2
}

get {
  url: {{ENV}}/api/spells?name=Amb
  body: json
  auth: inherit
}

params:query {
  name: Amb
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: example
  
  request: {
    url: {{ENV}}/api/spells?pageSize=49&page=1&magicSchool=Illusion&duration=Instantaneous
    method: GET
    mode: none
    params:query: {
      pageSize: 49
      page: 1
      magicSchool: Illusion
      duration: Instantaneous
    }
  }
  
  response: {
    headers: {
      content-type: application/json; charset=utf-8
      date: Thu, 12 Feb 2026 14:45:02 GMT
      server: Kestrel
      transfer-encoding: chunked
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "items": [
            {
              "name": "Abhorrent Apparition",
              "description": "You imbue a terrifying visage onto a gourd and toss it ahead of you to a spot of your choosing within range. Each creature within 15 feet of that spot takes 6d8 psychic damage and becomes frightened of you for 1 minute; a successful Wisdom saving throw halves the damage and negates the fright. A creature frightened in this way repeats the saving throw at the end of each of its turns, ending the effect on itself on a success.\n",
              "level": 4,
              "effectsAtHigherLevels": "If you cast this spell using a spell slot of 5th level or higher, the damage increases by 1d8 for each slot level above 4th.",
              "classes": [],
              "duration": "Instantaneous",
              "durationValue": 1,
              "castingTime": "Action",
              "castingTimeValue": 1,
              "reactionCondition": "",
              "magicSchool": "Illusion",
              "damageRoll": "",
              "damageTypes": [],
              "spellTypes": [],
              "spellTargeting": {
                "targetType": "",
                "range": "Feet",
                "rangeValue": 60,
                "shapeType": "",
                "shapeWidth": null,
                "shapeLength": null
              },
              "castingRequirements": {
                "verbal": false,
                "somatic": false,
                "materials": "a gourd with a face carved on it",
                "materialCost": 0,
                "materialsConsumed": false
              },
              "id": 1,
              "createdAt": "2026-02-08T14:27:33.73497Z",
              "updatedAt": null,
              "createdBy": null,
              "isHomebrew": false,
              "isPublic": true,
              "cloningAllowed": true,
              "cloningHistory": []
            }
          ],
          "itemCount": 1,
          "page": 1,
          "pageSize": 49,
          "next": null,
          "prev": null
        }
      '''
    }
  }
}

example {
