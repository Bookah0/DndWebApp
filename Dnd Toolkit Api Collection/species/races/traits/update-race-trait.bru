meta {
  name: update race trait
  type: http
  seq: 4
}

patch {
  url: {{ENV}}/api/races/{{raceId}}/traits/{{traitId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Superior Darkvision",
    "description": "You can see in dim light within 120 feet as if it were bright light.",
    "newRaceId": 2,
    "isPublic": true,
    "cloningAllowed": false
  }
}

vars:pre-request {
  raceId: 1
  traitId: 62
}

settings {
  encodeUrl: true
  timeout: 0
}
