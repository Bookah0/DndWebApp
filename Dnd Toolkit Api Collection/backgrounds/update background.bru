meta {
  name: update background
  type: http
  seq: 4
}

patch {
  url: {{ENV}}/api/backgrounds/{{backgroundId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Sage",
    "description": "You spent years learning the lore of the multiverse.",
    "startingCurrency": {
      "gold": 10,
      "silver": 5
    },
    "isPublic": true,
    "cloningAllowed": false
  }
}

vars:pre-request {
  spellId: 51
  backgroundId: 51
}

settings {
  encodeUrl: true
  timeout: 0
}
