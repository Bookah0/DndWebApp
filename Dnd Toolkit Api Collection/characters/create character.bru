meta {
  name: create character
  type: http
  seq: 3
}

post {
  url: {{ENV}}/api/users/{{userId}}/characters
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Arial Romanio",
    "level": 1,
    "experience": 6500,
    "playerName": "John",
    "raceId": 1,
    "subraceId": 7,
    "classId": 2,
    "subClassId": 4,
    "backgroundId": 2,
    "abilityScores": {
      "str": 10,
      "dex": 18,
      "con": 12,
      "int": 14,
      "wis": 13,
      "cha": 16
    },
    "characterInfo": {
      "alignmentId": 3,
      "personalityTraits": "I always have a plan for when things go wrong.",
      "ideals": "Freedom. Chains are meant to be broken.",
      "bonds": "I protect those who cannot protect themselves.",
      "flaws": "I have trouble trusting anyone but myself.",
      "age": 127,
      "height": 165,
      "weight": 55,
      "eyes": "Silver",
      "skin": "Pale",
      "hair": "White",
      "alliesAndOrganizations": "The Harpers",
      "backstory": "Born in the forest of Cormanthor, Aria left her home after...",
      "characterPictureUrl": "https://example.com/aria.png"
    }
  }
}

vars:pre-request {
  userId: 019c75a9-07c4-7da9-9a16-ec3a8b73a006
}

settings {
  encodeUrl: true
  timeout: 0
}
