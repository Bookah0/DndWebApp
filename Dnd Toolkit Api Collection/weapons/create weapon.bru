    "DamageTypes": [
      "Slashing"
    ],
    "Properties": [
      "Versatile"
    ],
    "VersitileDamageDice": "1d10"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: create
  
