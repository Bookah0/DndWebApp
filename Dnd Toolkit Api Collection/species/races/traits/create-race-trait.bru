meta {
  name: create race trait
  type: http
  seq: 3
}

post {
  url: {{ENV}}/api/races/{{raceId}}/traits
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Darkvision",
    "description": "You can see in dim light within 60 feet as if it were bright light.",
    "raceId": 1
  }
}

vars:pre-request {
  raceId: 1
}

settings {
  encodeUrl: true
  timeout: 0
}
