    body: {
      type: json
      content: '''
        {
          "items": [
            {
              "name": "Ambush",
              "description": "The forest floor swirls and shifts around you to welcome you into its embrace. While in a forest, you have advantage on Dexterity (Stealth) checks to Hide. While hidden in a forest, you have advantage on your next Initiative check. The spell ends if you attack or cast a spell.",
              "level": 1,
              "effectsAtHigherLevels": "When you cast this spell using a spell slot of 2nd level or higher, you can affect one additional creature for each slot level above 1st. The spell ends if you or any target of this spell attacks or casts a spell.",
              "classes": [],
              "duration": "Hour",
              "durationValue": 1,
              "castingTime": "Action",
