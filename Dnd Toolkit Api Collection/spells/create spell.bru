meta {
  name: create spell
  type: http
  seq: 3
}

post {
  url: {{ENV}}/api/spells
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Fireball",
    "description": "A bright streak flashes from your pointing finger to a point of your choice within range and then blossoms with a low roar into an explosion of flame.",
    "level": 3,
    "effectsAtHigherLevels": "When you cast this spell using a spell slot of 4th level or higher, the damage increases by 1d6 for each slot level above 3rd.",
    "duration": "Instantaneous",
    "durationValue": null,
    "castingTime": "action",
    "castingTimeValue": 1,
    "reactionCondition": "",
    "magicSchool": "Evocation",
    "spellTypes": ["AOE", "Damage"],
    "damageRoll": "8d6",
    "damageTypes": ["Fire"],
    "targetingDto": {
      "targetType": "Point",
      "range": "feet",
      "rangeValue": 150,
      "shapeType": "Sphere",
      "shapeWidth": "20",
      "shapeLength": ""
    },
    "castRequirementsDto": {
      "verbal": true,
      "somatic": true,
      "materials": "A tiny ball of bat guano and sulfur",
      "materialCost": 0,
      "materialsConsumed": false
    }
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}

