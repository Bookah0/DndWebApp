meta {
  name: update spell
  type: http
  seq: 4
}

patch {
  url: {{ENV}}/api/spells/{{spellId}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Fireball (Enhanced)",
    "description": "A bright streak flashes from your pointing finger to a point of your choice within range and then blossoms with a powerful roar into an explosion of flame.",
    "level": 4,
    "magicSchool": "Evocation",
    "damageRoll": "9d6",
    "targetingDto": {
      "rangeValue": 200,
      "shapeWidth": "25"
    },
    "castRequirementsDto": {
      "materialCost": 50
    }
  }
}

vars:pre-request {
  spellId: 51
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: example
  
  request: {
    url: {{ENV}}/api/spells/{{spellId}}
    method: PATCH
    mode: json
    body:json: {
      {
        "name": "Fireball (Enhanced)",
        "description": "A bright streak flashes from your pointing finger to a point of your choice within range and then blossoms with a powerful roar into an explosion of flame.",
        "level": 4,
        "magicSchool": "Evocation",
        "damageRoll": "9d6",
        "targetingDto": {
          "rangeValue": 200,
          "shapeWidth": "25"
        },
        "castRequirementsDto": {
          "materialCost": 50
        }
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json; charset=utf-8
      date: Wed, 11 Feb 2026 22:58:34 GMT
      server: Kestrel
      transfer-encoding: chunked
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "name": "Fireball (Enhanced)",
